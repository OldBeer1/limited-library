{
  "name": "limited-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "npm run build -w @limited-library/contracts && node scripts/dev.mjs",
    "test": "npm run build -w @limited-library/contracts && tsx --test tests/*.test.ts",
    "lint": "eslint .",
    "typecheck": "npm run build -w @limited-library/contracts && tsc -p apps/server/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json && tsc -p tests/tsconfig.json",
    "build": "npm run build -w @limited-library/contracts && npm run build -w @limited-library/web && npm run build -w @limited-library/server",
    "start": "node apps/server/dist/index.js",
    "init-data": "node apps/server/dist/index.js --init",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "test:design": "python scripts/check_design.py",
    "unlock": "tsx scripts/unlock.ts",
    "smoke": "node scripts/smoke.mjs",
    "test:ui": "node scripts/check-ui.mjs",
    "desktop": "npm run build && node scripts/launch-desktop.mjs",
    "desktop:prepare": "npm run build && node scripts/prepare-desktop.mjs",
    "desktop:pack": "npm run desktop:prepare && electron-builder --config electron-builder.yml --win --x64 --dir",
    "desktop:dist": "npm run desktop:prepare && electron-builder --config electron-builder.yml --win --x64",
    "test:desktop": "node scripts/check-desktop.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/cli": "0.1.22",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
